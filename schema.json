{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kamal 2.6 Config",
  "description": "Configuration schema for Kamal 2.6 deployment tool.",
  "type": "object",
  "properties": {
    "kamal_version": {
      "type": "string",
      "description": "Version of Kamal this configuration is for."
    },
    "minimum_version": {
      "type": "string",
      "description": "Minimum Kamal version required to use this configuration."
    },
    "service": {
      "type": "string",
      "description": "Name of your application. Used to uniquely configure containers."
    },
    "image": {
      "type": "string",
      "description": "Name of the container image."
    },
    "servers": {
      "type": "object",
      "description": "Servers to deploy to, organized by roles.",
      "patternProperties": {
        "^[a-z0-9_-]+$": {
          "type": "object",
          "description": "Configuration for a specific server role.",
          "properties": {
            "hosts": {
              "type": "array",
              "description": "List of servers for a specific role.",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": "Server hostname or IP address."
                  },
                  {
                    "type": "object",
                    "description": "Server with tags.",
                    "properties": {
                      "host": {
                        "type": "string",
                        "description": "Server hostname or IP address."
                      },
                      "tags": {
                        "type": "array",
                        "description": "List of tags for the server.",
                        "items": {
                          "type": "string"
                        }
                      },
                      "primary": {
                        "type": "boolean",
                        "description": "Mark this server as primary in its role."
                      }
                    },
                    "required": ["host"]
                  }
                ]
              }
            },
            "cmd": {
              "type": "string",
              "description": "Custom command to run for this role."
            },
            "labels": {
              "type": "object",
              "description": "Labels to apply to the containers for this role.",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": ["hosts"]
        }
      },
      "additionalProperties": false
    },
    "proxy": {
      "oneOf": [
        {
          "type": "boolean",
          "description": "When set to false, the proxy is disabled."
        },
        {
          "type": "object",
          "description": "Configuration for kamal-proxy.",
          "properties": {
            "letsencrypt": {
              "type": "boolean",
              "description": "Enable automatic HTTPS via Let's Encrypt."
            },
            "letsencrypt_args": {
              "type": "string",
              "description": "Additional arguments for Let's Encrypt."
            },
            "force_ssl": {
              "type": "boolean",
              "description": "Force SSL by redirecting HTTP to HTTPS."
            },
            "host": {
              "type": "string",
              "description": "The host that will be used to serve the app."
            },
            "port": {
              "type": "integer",
              "description": "The port the proxy will listen on.",
              "default": 80
            },
            "app_port": {
              "type": "integer",
              "description": "The port the application container is exposed on.",
              "default": 3000
            },
            "reuse_port": {
              "type": "boolean",
              "description": "Enable SO_REUSEPORT on the proxy."
            },
            "response_timeout": {
              "type": "integer",
              "description": "How long to wait for requests to complete before timing out.",
              "default": 30
            },
            "basic_auth": {
              "type": "object",
              "description": "Basic authentication configuration.",
              "properties": {
                "username": {
                  "type": "string",
                  "description": "Username for basic authentication."
                },
                "password": {
                  "type": "string",
                  "description": "Password for basic authentication."
                }
              },
              "required": ["username", "password"]
            },
            "healthcheck_path": {
              "type": "string",
              "description": "Path for healthcheck requests."
            },
            "custom_healthcheck_path": {
              "type": "string",
              "description": "Custom path for healthcheck requests."
            },
            "skip_exists_check": {
              "type": "boolean",
              "description": "Skip checking if the proxy container already exists."
            },
            "healthcheck": {
              "type": "object",
              "description": "Healthcheck configuration.",
              "properties": {
                "interval": {
                  "type": "integer",
                  "description": "Healthcheck interval in seconds."
                },
                "path": {
                  "type": "string",
                  "description": "Healthcheck path."
                },
                "timeout": {
                  "type": "integer",
                  "description": "Healthcheck timeout in seconds."
                }
              }
            },
            "buffering": {
              "type": "object",
              "description": "Buffering configuration.",
              "properties": {
                "requests": {
                  "type": "boolean",
                  "description": "Enable request buffering."
                },
                "responses": {
                  "type": "boolean",
                  "description": "Enable response buffering."
                },
                "max_request_body": {
                  "type": "integer",
                  "description": "Maximum request body size in bytes."
                },
                "max_response_body": {
                  "type": "integer",
                  "description": "Maximum response body size in bytes."
                },
                "memory": {
                  "type": "integer",
                  "description": "Memory limit for buffering in bytes."
                }
              }
            },
            "logging": {
              "type": "object",
              "description": "Request logging configuration.",
              "properties": {
                "request_headers": {
                  "type": "array",
                  "description": "Request headers to log.",
                  "items": {
                    "type": "string"
                  }
                },
                "response_headers": {
                  "type": "array",
                  "description": "Response headers to log.",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "registry": {
      "type": "object",
      "description": "Credentials for your image host.",
      "properties": {
        "server": {
          "type": "string",
          "description": "Specify the registry server, if you're not using Docker Hub."
        },
        "username": {
          "description": "Registry username.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "password": {
          "description": "Registry password.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Inject ENV variables into containers.",
      "properties": {
        "clear": {
          "type": "object",
          "description": "Clear environment variables.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "secret": {
          "type": "array",
          "description": "Secret environment variables (from .kamal/secrets).",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "object",
          "description": "Tag-specific environment variables.",
          "patternProperties": {
            "^[a-z0-9_-]+$": {
              "type": "object",
              "properties": {
                "clear": {
                  "type": "object",
                  "description": "Clear environment variables for the tag.",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "secret": {
                  "type": "array",
                  "description": "Secret environment variables for the tag.",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {
        "type": "object",
        "description": "Kubernetes specific environment variables.",
        "properties": {
          "secret_name": {
            "type": "string",
            "description": "Name of the Kubernetes secret to load."
          }
        }
      }
    },
    "ssh": {
      "type": "object",
      "description": "SSH configuration.",
      "properties": {
        "user": {
          "type": "string",
          "description": "SSH username.",
          "default": "root"
        },
        "port": {
          "type": "integer",
          "description": "SSH port.",
          "default": 22
        },
        "proxy": {
          "type": "string",
          "description": "SSH proxy host."
        },
        "proxy_command": {
          "type": "string",
          "description": "Custom SSH proxy command."
        },
        "log_level": {
          "type": "string",
          "description": "SSH log level.",
          "enum": ["fatal", "error", "warn", "info", "debug"],
          "default": "fatal"
        },
        "keys_only": {
          "type": "boolean",
          "description": "Use only private keys from keys and key_data parameters.",
          "default": false
        },
        "keys": {
          "type": "array",
          "description": "File names of private keys to use for authentication.",
          "items": {
            "type": "string"
          }
        },
        "key_data": {
          "type": "array",
          "description": "Raw private keys in PEM format.",
          "items": {
            "type": "string"
          }
        },
        "sudo_password": {
          "type": "string",
          "description": "Password for sudo commands."
        },
        "permit_root_login": {
          "type": "boolean",
          "description": "Allow root login.",
          "default": true
        },
        "forward_agent": {
          "type": "boolean",
          "description": "Enable SSH agent forwarding.",
          "default": false
        }
      }
    },
    "builder": {
      "type": "object",
      "description": "Configure builder setup.",
      "properties": {
        "args": {
          "type": "object",
          "description": "Arguments to pass to the builder.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "description": "Secrets to pass to the builder.",
          "items": {
            "type": "string"
          }
        },
        "remote": {
          "type": "string",
          "description": "Remote builder host."
        },
        "arch": {
          "type": "string",
          "description": "Target architecture for the build."
        },
        "cache": {
          "type": "object",
          "description": "Cache configuration for the builder.",
          "properties": {
            "type": {
              "type": "string",
              "description": "Cache type (e.g., 'gha', 'registry')."
            },
            "options": {
              "type": "object",
              "description": "Cache options.",
              "additionalProperties": true
            }
          }
        },
        "dockerfile": {
          "type": "string",
          "description": "Path to the Dockerfile.",
          "default": "Dockerfile"
        },
        "hooks": {
          "type": "object",
          "description": "Hooks to run during the build process.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "Command to run for the hook."
              },
              "description": {
                "type": "string",
                "description": "Description of the hook."
              }
            },
            "required": ["command"]
          }
        },
        "multiarch": {
          "type": "boolean",
          "description": "Enable multi-arch builds.",
          "default": true
        },
        "native": {
          "type": "boolean",
          "description": "Enable native builds.",
          "default": false
        },
        "skip_push": {
          "type": "boolean",
          "description": "Skip pushing the image after building.",
          "default": false
        }
      }
    },
    "accessories": {
      "type": "object",
      "description": "Additional services to run in Docker.",
      "patternProperties": {
        "^[a-z0-9_-]+$": {
          "type": "object",
          "description": "Configuration for an accessory service.",
          "properties": {
            "image": {
              "type": "string",
              "description": "Docker image for the accessory."
            },
            "host": {
              "type": "string",
              "description": "Host to run the accessory on."
            },
            "hosts": {
              "type": "array",
              "description": "List of hosts to run the accessory on.",
              "items": {
                "type": "string",
                "description": "Individual host to run the accessory on."
              }
            },
            "port": {
              "description": "Port mapping for the accessory.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "internal_port": {
              "type": "integer",
              "description": "Internal port the accessory container is listening on."
            },
            "cmd": {
              "type": "string",
              "description": "Custom command to run in the accessory container."
            },
            "directories": {
              "type": "array",
              "description": "Directories to mount into the accessory container.",
              "items": {
                "type": "string",
                "description": "Directory mapping (local:remote)."
              }
            },
            "env": {
              "type": "object",
              "description": "Environment variables for the accessory.",
              "properties": {
                "clear": {
                  "type": "object",
                  "description": "Clear environment variables.",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                },
                "secret": {
                  "type": "array",
                  "description": "Secret environment variables.",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "secrets": {
              "type": "array",
              "description": "Secrets to pass to the accessory container.",
              "items": {
                "type": "string"
              }
            },
            "labels": {
              "type": "object",
              "description": "Labels to apply to the accessory container.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "logging": {
              "type": "object",
              "description": "Logging configuration for the accessory.",
              "properties": {
                "driver": {
                  "type": "string",
                  "description": "Logging driver."
                },
                "options": {
                  "type": "object",
                  "description": "Logging driver options.",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "skip_push": {
              "type": "boolean",
              "description": "Skip pushing the accessory image.",
              "default": false
            },
            "options": {
              "type": "object",
              "description": "Additional options for the accessory container.",
              "additionalProperties": true
            },
            "proxy": {
              "type": "object",
              "description": "Proxy settings for the accessory",
              "properties": {
                "host": {
                    "type": "string",
                    "description": "host for the accessory"
                },
                "ssl": {
                  "type": "boolean",
                  "description": "Enable SSL for the accessory"
                },
                "healthcheck": {
                  "type": "object",
                  "description": "Healthcheck configuration for the accessory.",
                  "properties":{
                    "interval": {
                      "type": "integer",
                      "description": "interval in seconds"
                    },
                    "timeout": {
                      "type": "integer",
                      "description": "timeout in seconds"
                    },
                    "path":{
                      "type": "string",
                      "description": "path for healthcheck"
                    },
                    "port": {
                      "type": "integer",
                      "description": "Port for healthcheck."
                    },
                    "cmd": {
                      "type": "string",
                      "description": "Command for healthcheck."
                    },
                    "log_lines": {
                      "type": "integer",
                      "description": "Number of log lines to check for health."
                    },
                    "max_attempts": {
                      "type": "integer",
                      "description": "Maximum attempts for healthcheck."
                    },
                    "fail_threshold": {
                      "type": "integer",
                      "description": "Failure threshold for healthcheck."
                    },
                    "success_threshold": {
                      "type": "integer",
                      "description": "Success threshold for healthcheck."
                    },
                    "period_seconds": {
                      "type": "integer",
                      "description": "Period in seconds for healthcheck."
                    }
                  }
                }
              }
            },
            "readiness_probe": {
              "type": "object",
              "description": "Readiness probe configuration for the accessory.",
              "properties": {
                "cmd": {
                  "type": "string",
                  "description": "Command for readiness probe."
                },
                "interval": {
                  "type": "integer",
                  "description": "Interval in seconds for readiness probe."
                },
                "timeout": {
                  "type": "integer",
                  "description": "Timeout in seconds for readiness probe."
                }
              }
            }
          },
          "required": ["image"],
          "anyOf": [
            { "required": ["host"] },
            { "required": ["hosts"] }
          ]
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "description": "Hooks to run during deployment.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command to run for the hook."
          },
          "description": {
            "type": "string",
            "description": "Description of the hook."
          },
          "roles": {
            "type": "array",
            "description": "Roles to run the hook on.",
            "items": {
              "type": "string"
            }
          },
          "hosts": {
            "type": "array",
            "description": "Hosts to run the hook on.",
            "items": {
              "type": "string"
            }
          },
          "run_once": {
            "type": "boolean",
            "description": "Run the hook only once per deployment.",
            "default": false
          }
        },
        "required": ["command"]
      }
    }
  },
  "required": ["service", "image", "servers", "registry"]
}